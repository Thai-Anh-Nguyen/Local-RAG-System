# Copy to .env and adjust. Every value has a default in backend/rag/config.py.

# --- Ollama ---
# Dev mode: host Ollama. In Docker this is overridden to http://ollama:11434.
RAG_OLLAMA_URL=http://127.0.0.1:11434
RAG_LLM_MODEL=llama3.1:8b
# Models the UI is allowed to offer (comma-separated). Only those actually pulled are shown.
RAG_LLM_ALLOWLIST=llama3.1:8b,qwen2.5:0.5b
RAG_EMBED_MODEL=nomic-embed-text
# Add nomic's task prefixes (search_document: / search_query:). Set false to reproduce the baseline.
RAG_EMBED_PREFIXES=true
RAG_TEMPERATURE=0.1
RAG_NUM_CTX=8192

# --- Chroma (server mode) ---
RAG_CHROMA_HOST=127.0.0.1
RAG_CHROMA_PORT=8000
RAG_COLLECTION=cs_handbook

# --- Ingestion ---
# pymupdf (default, keeps tables/headings) or pypdf (baseline-style plain text)
RAG_PDF_PARSER=pymupdf
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
# Ingested at API startup when the collection is empty
RAG_DATA_DIR=data/handbooks

# --- Retrieval / answering ---
RAG_TOP_K=5
# Top-1 cosine similarity below this -> refuse without calling the LLM (calibrated in testing)
RAG_RELEVANCE_THRESHOLD=0.5
RAG_HISTORY_TURNS=3
